# syntax=docker/dockerfile:1

# Horizon (https://github.com/horizon-rust/horizon), Minecraft: Java Edition 26.3 rewritten in Rust,
# with the same Git backups as the Java image. Only Linux x86_64 builds are published.
# Pin a dated nightly (see the releases page) and test a newer one before switching.
ARG HORIZON_VERSION=nightly-2026-11-04

FROM debian:bookworm-slim AS fetch

ARG HORIZON_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/horizon

# The release's SHA256SUMS guards against a corrupted or swapped archive.
RUN base="https://github.com/horizon-rust/horizon/releases/download/${HORIZON_VERSION}" \
    && curl -fsSLO --retry 3 "$base/horizon-server-linux-x86_64.tar.gz" \
    && curl -fsSLO --retry 3 "$base/SHA256SUMS" \
    && grep ' horizon-server-linux-x86_64.tar.gz$' SHA256SUMS | sha256sum -c - \
    && mkdir /out \
    && tar -xzf horizon-server-linux-x86_64.tar.gz -C /out --strip-components=1

FROM debian:bookworm-slim

ARG HORIZON_VERSION

LABEL org.opencontainers.image.title="minecraft-backup (Horizon)" \
      org.opencontainers.image.description="Horizon, the Minecraft 26.3 server in Rust, with automatic Git/GitHub world backups" \
      org.opencontainers.image.source="https://github.com/danieltorquatof/minecraft-backup" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${HORIZON_VERSION}"

# git for the backups, gosu to drop to the server user, curl/unzip/xz for HORIZON_RESOURCES_URL.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git gosu unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --user-group --home-dir /data --no-create-home --shell /usr/sbin/nologin horizon \
    && mkdir -p /data /opt/horizon/.local/horizon-client \
    && chown horizon:horizon /data

COPY --from=fetch /out/ /opt/horizon/

# UID/GID: the server user, as in itzg/minecraft-server (bash would otherwise see root's UID).
# HORIZON_NO_UPDATE_CHECK: a container is updated by rebuilding it with another HORIZON_VERSION.
ENV PATH=/opt/horizon:$PATH \
    UID=1000 \
    GID=1000 \
    SERVER_FLAVOR=horizon \
    HORIZON_NO_AUDIO=1 \
    HORIZON_NO_UPDATE_CHECK=1

COPY --chmod=755 entrypoint.sh /opt/minecraft-backup/
COPY --chmod=755 utils/ /opt/minecraft-backup/utils/
COPY --chmod=755 scripts/ /opt/minecraft-backup/scripts/

WORKDIR /data
VOLUME /data
EXPOSE 25565

HEALTHCHECK --start-period=3m --interval=30s --timeout=10s --retries=3 \
    CMD ["/opt/minecraft-backup/scripts/healthcheck.sh"]

ENTRYPOINT ["/opt/minecraft-backup/entrypoint.sh"]
