# ----- Backup (required) -----
GITHUB_USER=
GITHUB_TOKEN=
# Repository name only, not the URL. Also used as the world folder name.
REPO_NAME=

# Minutes between automatic backups.
PERIODIC_INTERVAL=15

GIT_AUTHOR_NAME="Minecraft Autosave"
GIT_AUTHOR_EMAIL=bot@example.com

# ----- Backup (optional) -----
# Any git remote instead of https://github.com/$GITHUB_USER/$REPO_NAME.git
# GIT_REMOTE_URL=
# Branch used when the backup repository is created from scratch.
# GIT_BRANCH=main

# ----- Server -----
# Base image tag (java25 for current Minecraft versions, java21/java17/java8 for older ones).
MC_IMAGE_TAG=java25
# Port players connect to on the host.
MC_HOST_PORT=25565
MEMORY=4G
TYPE=VANILLA
VERSION=LATEST

SERVER_NAME=MineServer
MODE=survival
DIFFICULTY=normal
# SEED=

# Leave unset to get a random password on every start (backups still work).
# RCON_PASSWORD=
