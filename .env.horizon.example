# Copy to .env and use with: docker compose -f docker-compose.horizon.yml up -d --build

# ----- Backup (required) -----
GITHUB_USER=
GITHUB_TOKEN=
# Repository name only, not the URL. Also used as the world folder name.
REPO_NAME=

# Minutes between automatic backups.
PERIODIC_INTERVAL=15

GIT_AUTHOR_NAME="Minecraft Autosave"
GIT_AUTHOR_EMAIL=bot@example.com

# ----- Backup (optional) -----
# Any git remote instead of https://github.com/$GITHUB_USER/$REPO_NAME.git
# GIT_REMOTE_URL=
# Branch used when the backup repository is created from scratch.
# GIT_BRANCH=main

# ----- Horizon game files (one of them is required) -----
# The prepared 26.3 folder on this machine (the one with horizon-resources.json), mounted read-only.
HORIZON_RESOURCES_DIR=
# Or a .zip/.tar archive of that folder, downloaded once into data/resources/.
# HORIZON_RESOURCES_URL=

# ----- Horizon server -----
# Release to build (https://github.com/horizon-rust/horizon/releases), Linux x86_64 only.
HORIZON_VERSION=nightly-2026-11-04
# Port players connect to on the host.
MC_HOST_PORT=25565

# Accepts the Minecraft EULA (https://aka.ms/MinecraftEULA). Required.
HORIZON_EULA=true

# Only read on the first start, to write data/server.toml. Change server.toml afterwards.
HORIZON_ONLINE=true
HORIZON_WHITELIST=false
# HORIZON_PLAYERS=Alex,Steve
# HORIZON_OP=Alex
# HORIZON_SEED=

# Keep Horizon's own zip backups (data/backups/) besides the Git ones.
# HORIZON_BUILTIN_BACKUPS=false
